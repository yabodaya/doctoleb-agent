# Copy to .env and fill in. Never commit .env.

# App
APP_ENV=development
LOG_LEVEL=INFO
# Serve /docs, /redoc and /openapi.json. Off by default and independent of
# APP_ENV: the tunnel that lets Meta reach this API runs while APP_ENV=development,
# so tying the docs to APP_ENV would publish them to the internet. Turn this on
# for local Swagger UI, with no tunnel running.
DOCS_ENABLED=false

# Database / Redis
DATABASE_URL=postgresql+asyncpg://doctoleb:doctoleb@postgres:5432/doctoleb
REDIS_URL=redis://redis:6379/0

# Tests use a separate database on the same server. Leave unset and the test
# suite derives it by swapping the database name on DATABASE_URL to
# doctoleb_test, creating it on first run. Database tests skip when unreachable.
TEST_DATABASE_URL=

# Local Postgres container (docker-compose only; the app itself reads DATABASE_URL)
POSTGRES_USER=doctoleb
POSTGRES_PASSWORD=doctoleb
POSTGRES_DB=doctoleb

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=
# App Dashboard -> Settings -> Basic -> App Secret. Signs every webhook POST.
# Empty means every POST to /webhooks/whatsapp is rejected with 401.
META_APP_SECRET=
# A string you invent, then paste into the Meta webhook configuration form.
# Empty means the GET handshake is rejected with 403.
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=
# graph.facebook.com by default. Point it at a local fake if you have one.
META_API_BASE_URL=
# One attempt per job try, in seconds.
META_SEND_TIMEOUT_SECONDS=
# VS-008. ONE media call, in seconds, as a hard wall-clock deadline. Default 10.
# A voice note costs TWO of them - the media id is looked up to get a signed URL,
# then that URL is downloaded - so the pair is at most twice this, and
# JOB_TIMEOUT_SECONDS has to cover both plus the transcription.
META_MEDIA_TIMEOUT_SECONDS=

# Which WhatsApp number belongs to which clinic, as JSON:
#   WHATSAPP_TENANT_MAP={"100000000000001":"demo-clinic"}
# A tenant id is an OPAQUE string - probably a clinic username at the Booking
# Service. It is stored exactly as written here and matched case-sensitively,
# so "Demo-Clinic" and "demo-clinic" are two different clinics. Leading or
# trailing spaces and any non-printable character are refused at startup.
# Leave blank and DEV_TENANT_ID + META_PHONE_NUMBER_ID are used as a one-entry
# map instead. An unknown phone_number_id is a permanent failure: the event is
# dead-lettered, never guessed at (hard rule 4).
WHATSAPP_TENANT_MAP=
# Inbound message types that get a reply, comma-separated. Everything is stored
# regardless; this only gates replying. Default: text
WHATSAPP_REPLY_TO_TYPES=

# Worker retries (hard rule 11). Deferrals are base * 2^(try-1), capped.
JOB_MAX_TRIES=
JOB_BACKOFF_BASE_SECONDS=
JOB_BACKOFF_MAX_SECONDS=
# One whole job, in seconds. Default 140 (it was 90 before VS-008). It must
# stay ABOVE the voice step + AGENT_TURN_TIMEOUT_SECONDS + META_SEND_TIMEOUT_SECONDS,
# where the voice step is 2 x META_MEDIA_TIMEOUT_SECONDS + OPENAI_TRANSCRIBE_TIMEOUT_SECONDS:
#   2 x 10 + 20 = 40, then 40 + 45 + 10 = 95, so 140 leaves 45s for the job's
# five or six short database transactions. A job arq times out is finished as
# failed and never retried: no dead letter, no lease release, and nothing
# re-enqueues the event. The worker warns at startup when this no longer holds.
JOB_TIMEOUT_SECONDS=
# Added to JOB_TIMEOUT_SECONDS to get the claim lease. Must be > 0: a lease that
# expires mid-send lets a second worker send the same reply.
JOB_LEASE_MARGIN_SECONDS=

# OpenAI (VS-005: AI replies). The worker sends the patient's recent messages
# to OpenAI to write each reply. With OPENAI_API_KEY or OPENAI_CHAT_MODEL blank,
# nothing is sent: every reply is AGENT_FALLBACK_REPLY, and a dead letter says why.
OPENAI_API_KEY=
# The chat model. No default on purpose: model names come from here, never from
# code. Blank = every reply is the fallback, reason openai_model_unset.
OPENAI_CHAT_MODEL=
# ONE model call, in seconds, as a hard wall-clock deadline. Default 30.
# A turn makes up to six, all inside AGENT_TURN_TIMEOUT_SECONDS - so this is
# no longer what JOB_TIMEOUT_SECONDS has to cover.
OPENAI_TIMEOUT_SECONDS=
# Upper bound on a reply, in tokens. Default 1000. For reasoning models this
# also covers hidden reasoning tokens: too small, and replies come back cut off
# or empty and the patient gets the fallback (reason openai_reply_truncated).
OPENAI_MAX_OUTPUT_TOKENS=
# VS-008: the audio model that turns a voice note into text. No default on
# purpose, exactly like OPENAI_CHAT_MODEL. Blank = every voice note is answered
# with VOICE_NOTE_FAILED_REPLY, reason openai_transcribe_model_unset, and the
# worker says so at startup. Candidates, cheapest first: gpt-4o-mini-transcribe,
# gpt-transcribe, gpt-4o-transcribe, whisper-1. Confirm the price on your own
# OpenAI dashboard - it is charged per minute of audio, so a long voice note
# costs more than a short one.
OPENAI_TRANSCRIBE_MODEL=
# ONE transcription, in seconds, as a hard wall-clock deadline. Default 20.
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=
OPENAI_TTS_MODEL=

# Voice notes in (VS-008)
# The hard ceiling on one downloaded voice note, in bytes. Default 16777216
# (16 MiB), which is Meta's OWN documented maximum for an audio message - so a
# real voice note cannot exceed it. Its job is the forged payload and the
# response that lies about its length: the cap is checked against the declared
# size before a byte is fetched, against the running total while streaming, and
# the stream is abandoned the moment it is passed.
VOICE_NOTE_MAX_BYTES=
# Sent when a voice note arrived but transcribed to nothing usable - silence,
# noise, or one of the phrases these models emit when there is nothing to hear.
# The model is never called with it. Default (wrap the value in double quotes):
#   Sorry, I couldn't hear that voice note clearly. Could you record it again or
#   type your message? / <the same, in Arabic>
# It must ask for an ACTION - record it again, or type it - and claim nothing
# about the clinic. Arabic and English together, because on this path nothing
# was transcribed and the patient's language is unknown.
VOICE_NOTE_UNCLEAR_REPLY=
# Sent when we could not get or transcribe the audio at all: an expired media
# id, an oversized or unsupported file, no audio model configured, a refusal
# from the audio endpoint. Default (wrap the value in double quotes):
#   Sorry, I couldn't listen to that voice note. Please type your message, or
#   send a shorter voice note. / <the same, in Arabic>
# Deliberately NOT AGENT_FALLBACK_REPLY: "the clinic will get back to you" is
# untrue of a voice note nobody will ever hear.
VOICE_NOTE_FAILED_REPLY=

# Agent Core (VS-005)
# Earlier messages of the conversation sent with each reply, besides the one
# being answered. Default 20. Fewer is cheaper and more private; more remembers
# further back.
AGENT_HISTORY_MESSAGES=
# Sent when an AI reply cannot be produced (no credit, OpenAI down, model unset).
# Default: Sorry, we can't reply right now. The clinic will get back to you.
# It is sent whatever language the patient wrote in, so consider Arabic and
# English together. Wrap the value in double quotes.
# It must claim NEITHER success NOR failure: it is also what a patient gets when
# a booking change's outcome is unknown, and "sorry, that did not work" would be
# a claim we cannot make (VS-007 V6, hard rule 5).
AGENT_FALLBACK_REPLY=
# The WHOLE turn, in seconds: up to six model calls plus every tool call
# between them, under one deadline. Default 45. It is what a patient waits at
# worst before getting the fallback, and JOB_TIMEOUT_SECONDS must stay above
# it plus META_SEND_TIMEOUT_SECONDS.
AGENT_TURN_TIMEOUT_SECONDS=

# Booking Service
BOOKING_CLIENT=fake
BOOKING_BASE_URL=
BOOKING_SERVICE_TOKEN=

# Local dev tenant (until tenant mapping exists). Used with
# META_PHONE_NUMBER_ID when WHATSAPP_TENANT_MAP is blank. Same rules as
# above: opaque, stored exactly as written, case-sensitive.
DEV_TENANT_ID=
